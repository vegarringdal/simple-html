{
    "name": "@simple-html/grid",
    "version": "5.0.1",
    "description": "Vanillajs Grid",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "start": "tsx config_devserver",
        "build": "node ./scripts/build",
        "typecheck": "node typecheck",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=text",
        "test:watch": "vitest",
        "typedoc-grid": "npx typedoc --tsconfig tsconfig-typedoc.json --cleanOutputDir --out docs/grid ./src/index.ts ./src/datasource/grouping.ts ./src/datasource/filter.ts ./src/datasource/selection.ts ./src/datasource/sort.ts ./src/datasource/valueFormater.ts ./src/datasource/datasourceConfigOptions.ts ./src/grid/gridFunctions/colType.ts ./src/grid/gridFunctions/GROUP_COLTYPE.ts ./src/date/dateInterface.ts ./src/grid/gridConfig.ts ./src/grid/gridInterface.ts ./src/datasource/dataSource.ts ./src/grid/grid.ts"
    },
    "author": "Vegar Ringdal <vegar.ringdal@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/vegarringdal/simple-html",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vegarringdal/simple-html.git"
    },
    "bugs": {
        "url": "https://github.com/vegarringdal/simple-html/issues"
    },
    "dependencies": {
        "lit-html": "3.3.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.4",
        "@types/node": "26.1.1",
        "@vitest/coverage-v8": "4.1.10",
        "esbuild": "0.28.1",
        "esbuild-helpers": "2.0.5",
        "happy-dom": "20.11.0",
        "tsx": "4.23.1",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    }
}
