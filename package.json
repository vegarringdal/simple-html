{
    "name": "@simple-html/grid",
    "version": "5.0.1",
    "description": "Vanillajs Grid",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "typings": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./grid.css": "./dist/grid.css",
        "./date.css": "./dist/date.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/__tests__",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "start": "tsx config_devserver",
        "build": "node ./scripts/build",
        "build:tgz": "node ./scripts/pack",
        "build:demo": "node ./scripts/buildDemo",
        "prepare": "npm run build",
        "typecheck": "node typecheck",
        "check:typings": "npm run build && tsc -p scripts/typings-consumer",
        "check:docs": "npm run build && node scripts/checkDocs.js",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=text",
        "test:watch": "vitest",
        "typedoc-grid": "npx typedoc --tsconfig tsconfig-typedoc.json --cleanOutputDir --out docs/grid ./src/index.ts"
    },
    "author": "Vegar Ringdal <vegar.ringdal@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/vegarringdal/simple-html",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vegarringdal/simple-html.git"
    },
    "bugs": {
        "url": "https://github.com/vegarringdal/simple-html/issues"
    },
    "dependencies": {
        "lit-html": "^3.3.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.4",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "4.1.10",
        "esbuild": "0.28.1",
        "esbuild-helpers": "2.0.5",
        "happy-dom": "20.11.0",
        "marked": "18.1.3",
        "tsx": "4.23.1",
        "typedoc": "0.28.20",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    }
}
