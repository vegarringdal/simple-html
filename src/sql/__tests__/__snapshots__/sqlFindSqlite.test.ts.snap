  (("name" IS NOT NULL AND LOWER("name") LIKE $1 ESCAPE '!') OR ("notes" IS NOT NULL AND LOWER("notes") LIKE $2 ESCAPE '!') OR ("born" IS NOT NULL AND "born" >= CAST($3 AS timestamp) AND "born" < CAST($4 AS timestamp)))
